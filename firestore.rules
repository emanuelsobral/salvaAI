rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function positive(value) { return value is number && value > 0 && value <= 1000000000; }
    function text(value) { return value is string && value.size() > 0 && value.size() <= 600; }
    function contractText(value, maximum) { return value is string && value.size() <= maximum; }
    function contractDate(value) {
      return value is string && (value == '' || value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'));
    }
    function validSourceReview(source) {
      return source is map
        && source.keys().hasAll(['method', 'pdfSha256', 'extractorVersion', 'resultJson'])
        && source.keys().hasOnly(['method', 'pdfSha256', 'extractorVersion', 'resultJson'])
        && source.method in ['PDF_TEXT_REVIEW', 'PDF_OCR_REVIEW', 'PDF_DEEPSEEK_OCR_REVIEW'] && source.pdfSha256.matches('^[a-f0-9]{64}$')
        && source.extractorVersion is string && source.extractorVersion.size() <= 30
        && source.resultJson is string && source.resultJson.size() > 0 && source.resultJson.size() <= 100000;
    }
    function validContractPlan(plan) {
      return plan is map
        && plan.keys().hasAll(['subscriptionId', 'amount', 'count', 'frequency', 'firstDueDate', 'lastDueDate', 'contractRevision'])
        && plan.keys().hasOnly(['subscriptionId', 'amount', 'count', 'frequency', 'firstDueDate', 'lastDueDate', 'contractRevision'])
        && plan.subscriptionId is string && positive(plan.amount)
        && plan.count is int && plan.count >= 1 && plan.count <= 1200
        && plan.frequency in ['WEEKLY', 'MONTHLY', 'YEARLY']
        && contractDate(plan.firstDueDate) && plan.firstDueDate != ''
        && contractDate(plan.lastDueDate) && plan.lastDueDate >= plan.firstDueDate
        && plan.contractRevision is int && plan.contractRevision >= 0;
    }
    function planMatchesSubscription(plan, sub) {
      return sub.billingMode == 'ACCOUNT' && sub.amount == plan.amount
        && sub.frequency == plan.frequency && sub.startDate == plan.firstDueDate
        && sub.endDate == plan.lastDueDate && sub.installmentCount == plan.count;
    }
    function validClosure(closure) {
      let date = closure.closedOn.split('-');
      let midnight = timestamp.date(int(date[0]), int(date[1]), int(date[2]));
      return closure is map && closure.keys().hasAll(['closedOn', 'reason', 'subscriptionId'])
        && closure.keys().hasOnly(['closedOn', 'reason', 'subscriptionId'])
        && contractDate(closure.closedOn) && closure.closedOn != ''
        && contractText(closure.reason, 600)
        && (closure.subscriptionId == null || closure.subscriptionId is string)
        // Aceita a data corrente nos fusos locais; a prévia também confere o dia no dispositivo.
        && midnight - duration.value(14, 'h') <= request.time
        && midnight + duration.value(38, 'h') > request.time;
    }
    function closureSubscription(uid, id, closure) {
      let subPath = /databases/$(database)/documents/users/$(uid)/subscriptions/$(closure.subscriptionId);
      let before = get(subPath).data;
      let after = getAfter(subPath).data;
      return closure.subscriptionId == 'contract_' + id
        && resource.data.commitmentPlan.subscriptionId == closure.subscriptionId
        && before.contractId == id && after.isActive == false
        && (before.isActive == false ? after == before : (
          after.cancelledOn == closure.closedOn && after.cancelledAt == request.time
          && after.diff(before).affectedKeys().hasOnly(['isActive', 'cancelledOn', 'cancelledAt'])));
    }
    function contractClosureUpdate(uid, id) {
      let closure = request.resource.data.get('closure', null);
      return resource.data.get('closure', null) == null && (closure == null || (
        validClosure(closure)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['closure', 'revision', 'updatedAt'])
        && (resource.data.get('commitmentPlan', null) == null
          ? closure.subscriptionId == null : closureSubscription(uid, id, closure))));
    }
    function contractPlanUpdate(uid, id) {
      let before = resource.data.get('commitmentPlan', null);
      let after = request.resource.data.get('commitmentPlan', null);
      return before != null ? after == before : (after == null || (
        after.subscriptionId == 'contract_' + id && after.contractRevision == resource.data.revision
        && getAfter(/databases/$(database)/documents/users/$(uid)/subscriptions/$(after.subscriptionId)).data.contractId == id
        && planMatchesSubscription(after, getAfter(/databases/$(database)/documents/users/$(uid)/subscriptions/$(after.subscriptionId)).data)
      ));
    }
    function validContract(data) {
      return data.keys().hasAll(['title', 'counterparty', 'amount', 'installments', 'startDate', 'endDate', 'dueRule', 'adjustmentRule', 'notes', 'schemaVersion', 'revision', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['title', 'counterparty', 'amount', 'installments', 'startDate', 'endDate', 'dueRule', 'adjustmentRule', 'notes', 'schemaVersion', 'revision', 'createdAt', 'updatedAt', 'commitmentPlan', 'sourceReview', 'closure'])
        && (!data.keys().hasAny(['commitmentPlan']) || validContractPlan(data.commitmentPlan))
        && (!data.keys().hasAny(['sourceReview']) || validSourceReview(data.sourceReview))
        && text(data.title) && data.title.size() <= 500 && data.title.matches('.*[^\\s].*')
        && contractText(data.counterparty, 500) && contractText(data.dueRule, 600)
        && contractText(data.adjustmentRule, 600) && contractText(data.notes, 3000)
        && (data.amount == null || positive(data.amount))
        && (data.installments == null || (data.installments is int && data.installments >= 1 && data.installments <= 1200))
        && contractDate(data.startDate) && contractDate(data.endDate)
        && (data.startDate == '' || data.endDate == '' || data.endDate >= data.startDate)
        && data.schemaVersion == 1 && data.revision is int && data.revision >= 0
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    match /users/{uid}/contracts/{id} {
      allow read: if owner(uid);
      allow create: if owner(uid) && validContract(request.resource.data)
        && !request.resource.data.keys().hasAny(['commitmentPlan', 'closure'])
        && request.resource.data.revision == 0 && request.resource.data.createdAt == request.time;
      allow update: if owner(uid) && validContract(request.resource.data)
        && contractPlanUpdate(uid, id)
        && contractClosureUpdate(uid, id)
        && request.resource.data.get('sourceReview', null) == resource.data.get('sourceReview', null)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1;
    }
    match /users/{uid}/accounts/{id} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.type in ['GENERAL', 'VR', 'VA', 'CAIXINHA']
        && request.resource.data.balance is number
        && request.resource.data.balance >= -1000000000 && request.resource.data.balance <= 1000000000
        && text(request.resource.data.name);
    }
    match /users/{uid}/transactions/{id} {
      allow read, delete: if owner(uid);
      // Conciliação altera somente o vínculo; valor, conta, data e descrição permanecem imutáveis.
      allow update: if owner(uid)
        && resource.data.get('importFormat', '') in ['csv', 'ofx', 'pdf']
        && resource.data.type == 'EXPENSE' && resource.data.status == 'COMPLETED'
        && resource.data.accountType == 'GENERAL'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kind', 'subscriptionId', 'dueDate'])
        // Uma segunda confirmação concorrente pode ser avaliada após o primeiro commit.
        // A escrita idêntica precisa ser autorizada para o Firestore repetir a transação.
        && (request.resource.data.diff(resource.data).affectedKeys().size() == 0
        || (resource.data.kind == 'REGULAR' && request.resource.data.kind == 'RECURRING_PAYMENT'
          && request.resource.data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && getAfter(/databases/$(database)/documents/users/$(uid)/subscriptions/$(request.resource.data.subscriptionId)).data.payments.get(request.resource.data.dueDate, {}).get('transactionId', '') == id)
        || (resource.data.kind == 'RECURRING_PAYMENT' && request.resource.data.kind == 'REGULAR'
          && request.resource.data.subscriptionId == null && request.resource.data.dueDate == null
          && !getAfter(/databases/$(database)/documents/users/$(uid)/subscriptions/$(resource.data.subscriptionId)).data.payments.keys().hasAny([resource.data.dueDate])));
      allow create: if owner(uid) && positive(request.resource.data.amount)
        && request.resource.data.type in ['INCOME', 'EXPENSE']
        && request.resource.data.status in ['COMPLETED', 'PENDING']
        && request.resource.data.accountType in ['GENERAL', 'VR', 'VA', 'CAIXINHA']
        && text(request.resource.data.description)
        && request.resource.data.transactionDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && getAfter(/databases/$(database)/documents/users/$(uid)/accounts/$(request.resource.data.accountId)).data.type == request.resource.data.accountType;
    }
    match /users/{uid}/cardTransactions/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && positive(request.resource.data.amount)
        && request.resource.data.status in ['PENDING', 'PAID']
        && request.resource.data.invoiceMonth is int && request.resource.data.invoiceMonth >= 1 && request.resource.data.invoiceMonth <= 12
        && request.resource.data.invoiceYear is int && request.resource.data.invoiceYear >= 1900 && request.resource.data.invoiceYear <= 9999;
    }
    match /users/{uid}/creditCards/{id} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && text(request.resource.data.name)
        && request.resource.data.closingDay is int && request.resource.data.closingDay >= 1 && request.resource.data.closingDay <= 31
        && request.resource.data.dueDay is int && request.resource.data.dueDay >= 1 && request.resource.data.dueDay <= 31;
    }
    match /users/{uid}/subscriptions/{id} {
      function basicSubscription() {
        return positive(request.resource.data.amount) && text(request.resource.data.name)
          && request.resource.data.isActive is bool && request.resource.data.dueDay is int
          && request.resource.data.dueDay >= 1 && request.resource.data.dueDay <= 31;
      }
      function linkedContractCreation() {
        let data = request.resource.data;
        let contract = getAfter(/databases/$(database)/documents/users/$(uid)/contracts/$(data.contractId)).data;
        return id == 'contract_' + data.contractId && contract.commitmentPlan.subscriptionId == id
          && planMatchesSubscription(contract.commitmentPlan, data)
          && data.name == contract.title && data.isActive == true
          && data.payments is map && data.payments.size() == 0 && data.createdAt == request.time
          && data.keys().hasOnly(['name', 'amount', 'billingMode', 'frequency', 'startDate', 'endDate', 'dueDay', 'category', 'isActive', 'payments', 'contractId', 'installmentCount', 'createdAt']);
      }
      function validAdjustment(revision, before) {
        let previousAmount = before.size() == 0 ? resource.data.amount : before[before.size() - 1].amount;
        let date = revision.effectiveFrom.split('-');
        return revision.keys().hasAll(['effectiveFrom', 'amount', 'startDate', 'endDate', 'frequency', 'adjustmentType', 'adjustmentValue', 'previousAmount'])
          && revision.keys().hasOnly(['effectiveFrom', 'amount', 'startDate', 'endDate', 'frequency', 'adjustmentType', 'adjustmentValue', 'previousAmount'])
          && positive(revision.amount) && revision.amount != previousAmount
          && math.abs(revision.amount * 100 - math.round(revision.amount * 100)) < 0.000001
          && revision.previousAmount == previousAmount
          && revision.startDate == resource.data.startDate && revision.endDate == resource.data.endDate
          && revision.frequency == resource.data.frequency
          && contractDate(revision.effectiveFrom) && revision.effectiveFrom != ''
          && revision.effectiveFrom >= resource.data.startDate && revision.effectiveFrom <= resource.data.endDate
          && (before.size() == 0 || revision.effectiveFrom > before[before.size() - 1].effectiveFrom)
          && timestamp.date(int(date[0]), int(date[1]), int(date[2])) + duration.value(14, 'h') > request.time
          && ((revision.adjustmentType == 'AMOUNT' && revision.adjustmentValue == revision.amount)
            || (revision.adjustmentType == 'PERCENT' && revision.adjustmentValue is number
              && revision.adjustmentValue > -100 && revision.adjustmentValue <= 10000
              && math.abs(revision.adjustmentValue * 100 - math.round(revision.adjustmentValue * 100)) < 0.000001
              && math.abs(revision.amount * 100 - (previousAmount * 100 * (1 + revision.adjustmentValue / 100.0))) <= 0.50001));
      }
      function linkedContractAdjustment() {
        let before = resource.data.get('revisions', []);
        let after = request.resource.data.revisions;
        let contractPath = /databases/$(database)/documents/users/$(uid)/contracts/$(resource.data.contractId);
        let contractBefore = get(contractPath).data;
        let contractAfter = getAfter(contractPath).data;
        return resource.data.isActive == true && before.size() < 100
          && contractBefore.get('closure', null) == null && contractAfter.get('closure', null) == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revisions', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && after is list && after.size() == before.size() + 1
          && after == before.concat([after[before.size()]])
          && validAdjustment(after[before.size()], before)
          && contractBefore.commitmentPlan.subscriptionId == id
          && contractAfter.revision == contractBefore.revision + 1
          && contractAfter.diff(contractBefore).affectedKeys().hasOnly(['revision', 'updatedAt']);
      }
      function closedContractPaymentsOnly() {
        let contract = getAfter(/databases/$(database)/documents/users/$(uid)/contracts/$(resource.data.contractId)).data;
        return contract.get('closure', null) == null
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payments']);
      }
      function linkedContractClosure() {
        let contractPath = /databases/$(database)/documents/users/$(uid)/contracts/$(resource.data.contractId);
        let before = get(contractPath).data;
        let after = getAfter(contractPath).data;
        return before.get('closure', null) == null && after.get('closure', null) != null
          && after.closure.subscriptionId == id && after.revision == before.revision + 1
          && resource.data.isActive == true && request.resource.data.isActive == false
          && request.resource.data.cancelledOn == after.closure.closedOn
          && request.resource.data.cancelledAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive', 'cancelledOn', 'cancelledAt']);
      }
      allow read: if owner(uid);
      allow create: if owner(uid) && basicSubscription()
        && (!request.resource.data.keys().hasAny(['contractId']) || linkedContractCreation());
      allow update: if owner(uid) && basicSubscription()
        && (resource.data.keys().hasAny(['contractId'])
          ? (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payments', 'isActive', 'cancelledOn', 'cancelledAt'])
            && request.resource.data.payments is map
            && closedContractPaymentsOnly()
            && (request.resource.data.isActive == resource.data.isActive || request.resource.data.isActive == false)
            || linkedContractAdjustment() || linkedContractClosure())
          : !request.resource.data.keys().hasAny(['contractId']));
    }
    match /users/{uid}/invoices/{id} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && id.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.subscriptionPayments is map;
    }
    match /users/{uid}/operations/{id} {
      allow read: if owner(uid);
      allow create: if owner(uid) && request.resource.data.fingerprint is string && request.resource.data.result is map;
    }
    match /users/{uid}/importRows/{id} {
      allow read: if owner(uid);
      allow create: if owner(uid) && request.resource.data.transactionId is string;
    }
  }
}
