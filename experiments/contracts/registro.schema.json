{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Contrato — registro do experimento 1.0.0",
  "description": "Formato de extração e gabarito; validação estrutural não comprova conteúdo ou evidência.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolo_versao",
    "esquema_versao",
    "tipo_registro",
    "documento_id",
    "pdf_sha256",
    "versao_extrator",
    "anotacao",
    "processamento",
    "campos"
  ],
  "properties": {
    "protocolo_versao": {
      "const": "1.0.0"
    },
    "esquema_versao": {
      "const": "1.0.0"
    },
    "tipo_registro": {
      "enum": [
        "extracao",
        "gabarito",
        "exemplo_extracao",
        "exemplo_gabarito"
      ]
    },
    "documento_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
    },
    "pdf_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "versao_extrator": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "anotacao": {
      "anyOf": [
        {
          "$ref": "#/definitions/anotacao"
        },
        {
          "type": "null"
        }
      ]
    },
    "processamento": {
      "$ref": "#/definitions/processamento"
    },
    "campos": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valor_parcela",
        "numero_parcelas",
        "data_vencimento",
        "vigencia",
        "regra_reajuste"
      ],
      "properties": {
        "valor_parcela": {
          "allOf": [
            {
              "$ref": "#/definitions/campo"
            },
            {
              "properties": {
                "valor": {
                  "anyOf": [
                    {
                      "$ref": "#/definitions/valor_parcela"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          ]
        },
        "numero_parcelas": {
          "allOf": [
            {
              "$ref": "#/definitions/campo"
            },
            {
              "properties": {
                "valor": {
                  "anyOf": [
                    {
                      "$ref": "#/definitions/numero_parcelas"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          ]
        },
        "data_vencimento": {
          "allOf": [
            {
              "$ref": "#/definitions/campo"
            },
            {
              "properties": {
                "valor": {
                  "anyOf": [
                    {
                      "$ref": "#/definitions/data_vencimento"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          ]
        },
        "vigencia": {
          "allOf": [
            {
              "$ref": "#/definitions/campo"
            },
            {
              "properties": {
                "valor": {
                  "anyOf": [
                    {
                      "$ref": "#/definitions/vigencia"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          ]
        },
        "regra_reajuste": {
          "allOf": [
            {
              "$ref": "#/definitions/campo"
            },
            {
              "properties": {
                "valor": {
                  "anyOf": [
                    {
                      "$ref": "#/definitions/regra_reajuste"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    }
  },
  "definitions": {
    "evidencia": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pagina",
        "trecho"
      ],
      "properties": {
        "pagina": {
          "type": "integer",
          "minimum": 1
        },
        "trecho": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "campo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estado",
        "valor",
        "evidencias",
        "confianca",
        "regra_id",
        "motivo"
      ],
      "properties": {
        "estado": {
          "enum": [
            "encontrado",
            "nao_identificado",
            "ambiguo",
            "erro_leitura",
            "presente",
            "ausente",
            "ilegivel"
          ]
        },
        "valor": {
          "type": [
            "object",
            "null"
          ]
        },
        "evidencias": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/evidencia"
          }
        },
        "confianca": {
          "enum": [
            "alta",
            "media",
            "baixa",
            "nao_aplicavel"
          ]
        },
        "regra_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "motivo": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "estado": {
                "enum": [
                  "encontrado",
                  "presente"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "valor": {
                "type": "object"
              },
              "evidencias": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "valor": {
                "type": "null"
              },
              "confianca": {
                "const": "nao_aplicavel"
              },
              "motivo": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "estado": {
                "enum": [
                  "encontrado"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "confianca": {
                "enum": [
                  "alta",
                  "media",
                  "baixa"
                ]
              },
              "regra_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "anotacao": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anotador_id",
        "revisor_id",
        "estado_revisao",
        "data"
      ],
      "properties": {
        "anotador_id": {
          "type": "string",
          "minLength": 1
        },
        "revisor_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "estado_revisao": {
          "enum": [
            "revisao_unica",
            "revisado",
            "divergencias_pendentes"
          ]
        },
        "data": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "estado_revisao": {
                "enum": [
                  "revisado"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "revisor_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "processamento": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "duracao_ms",
        "erros"
      ],
      "properties": {
        "status": {
          "enum": [
            "concluido",
            "parcial",
            "falhou",
            "nao_executado"
          ]
        },
        "duracao_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "erros": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "codigo",
              "mensagem",
              "pagina"
            ],
            "properties": {
              "codigo": {
                "type": "string",
                "minLength": 1
              },
              "mensagem": {
                "type": "string",
                "minLength": 1
              },
              "pagina": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "parcial",
                  "falhou"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "erros": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "concluido"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "erros": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "valor_parcela": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tipo",
        "moeda",
        "quantia",
        "regra"
      ],
      "properties": {
        "tipo": {
          "enum": [
            "fixo",
            "variavel"
          ]
        },
        "moeda": {
          "const": "BRL"
        },
        "quantia": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "regra": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tipo": {
                "enum": [
                  "fixo"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "quantia": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
              },
              "regra": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tipo": {
                "enum": [
                  "variavel"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "quantia": {
                "type": "null"
              },
              "regra": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "numero_parcelas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tipo",
        "quantidade"
      ],
      "properties": {
        "tipo": {
          "enum": [
            "determinado",
            "indeterminado"
          ]
        },
        "quantidade": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tipo": {
                "enum": [
                  "determinado"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "quantidade": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tipo": {
                "enum": [
                  "indeterminado"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "quantidade": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "data_vencimento": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tipo",
        "data",
        "dia",
        "regra"
      ],
      "properties": {
        "tipo": {
          "enum": [
            "data_unica",
            "mensal",
            "outra_regra"
          ]
        },
        "data": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "dia": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 31
            },
            {
              "type": "null"
            }
          ]
        },
        "regra": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tipo": {
                "enum": [
                  "data_unica"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "string",
                "format": "date",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "dia": {
                "type": "null"
              },
              "regra": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tipo": {
                "enum": [
                  "mensal"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "null"
              },
              "dia": {
                "type": "integer",
                "minimum": 1,
                "maximum": 31
              },
              "regra": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tipo": {
                "enum": [
                  "outra_regra"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "null"
              },
              "dia": {
                "type": "null"
              },
              "regra": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "vigencia": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prazo",
        "inicio",
        "fim",
        "duracao_meses",
        "regra"
      ],
      "properties": {
        "prazo": {
          "enum": [
            "determinado",
            "indeterminado",
            "nao_informado"
          ]
        },
        "inicio": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "fim": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "duracao_meses": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "regra": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "prazo": {
                "enum": [
                  "indeterminado"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "fim": {
                "type": "null"
              },
              "duracao_meses": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "prazo": {
                "enum": [
                  "nao_informado"
                ]
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "inicio": {
                    "not": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "properties": {
                  "fim": {
                    "not": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "properties": {
                  "duracao_meses": {
                    "not": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "properties": {
                  "regra": {
                    "not": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "regra_reajuste": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tipo",
        "indices",
        "percentual",
        "periodicidade_meses",
        "regra"
      ],
      "properties": {
        "tipo": {
          "enum": [
            "indice",
            "percentual_fixo",
            "sem_reajuste",
            "outra_regra"
          ]
        },
        "indices": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "percentual": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "periodicidade_meses": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "regra": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tipo": {
                "enum": [
                  "indice"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "indices": {
                "minItems": 1
              },
              "percentual": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tipo": {
                "enum": [
                  "percentual_fixo"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "indices": {
                "maxItems": 0
              },
              "percentual": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tipo": {
                "enum": [
                  "sem_reajuste"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "indices": {
                "maxItems": 0
              },
              "percentual": {
                "type": "null"
              },
              "periodicidade_meses": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tipo": {
                "enum": [
                  "outra_regra"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "indices": {
                "maxItems": 0
              },
              "percentual": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tipo_registro": {
            "enum": [
              "extracao",
              "exemplo_extracao"
            ]
          }
        }
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "anotacao": {
                "type": "null"
              }
            }
          },
          {
            "properties": {
              "campos": {
                "properties": {
                  "valor_parcela": {
                    "properties": {
                      "estado": {
                        "enum": [
                          "encontrado",
                          "nao_identificado",
                          "ambiguo",
                          "erro_leitura"
                        ]
                      }
                    }
                  },
                  "numero_parcelas": {
                    "properties": {
                      "estado": {
                        "enum": [
                          "encontrado",
                          "nao_identificado",
                          "ambiguo",
                          "erro_leitura"
                        ]
                      }
                    }
                  },
                  "data_vencimento": {
                    "properties": {
                      "estado": {
                        "enum": [
                          "encontrado",
                          "nao_identificado",
                          "ambiguo",
                          "erro_leitura"
                        ]
                      }
                    }
                  },
                  "vigencia": {
                    "properties": {
                      "estado": {
                        "enum": [
                          "encontrado",
                          "nao_identificado",
                          "ambiguo",
                          "erro_leitura"
                        ]
                      }
                    }
                  },
                  "regra_reajuste": {
                    "properties": {
                      "estado": {
                        "enum": [
                          "encontrado",
                          "nao_identificado",
                          "ambiguo",
                          "erro_leitura"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "else": {
        "allOf": [
          {
            "properties": {
              "versao_extrator": {
                "type": "null"
              },
              "anotacao": {
                "$ref": "#/definitions/anotacao"
              },
              "processamento": {
                "properties": {
                  "status": {
                    "const": "nao_executado"
                  },
                  "duracao_ms": {
                    "type": "null"
                  },
                  "erros": {
                    "maxItems": 0
                  }
                }
              }
            }
          },
          {
            "properties": {
              "campos": {
                "properties": {
                  "valor_parcela": {
                    "properties": {
                      "estado": {
                        "enum": [
                          "presente",
                          "ausente",
                          "ambiguo",
                          "ilegivel"
                        ]
                      },
                      "confianca": {
                        "const": "nao_aplicavel"
                      },
                      "regra_id": {
                        "type": "null"
                      }
                    }
                  },
                  "numero_parcelas": {
                    "properties": {
