# Copie para .env.local e preencha com a configuração Web do seu Firebase.
# Estes valores são públicos no navegador; a autorização depende das regras.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Opcionais para os serviços atuais (Auth e Firestore).
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# IA opcional. A chave fica somente no servidor, nunca em variáveis VITE_*.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-flash
# No deploy, disponibilize este ID também para as Functions (não é segredo).
FIREBASE_PROJECT_ID=
