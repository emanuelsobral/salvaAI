# Copie para .env.local e preencha com a configuração Web do seu Firebase.
# Estes valores são públicos no navegador; a autorização depende das regras.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Opcionais para os serviços atuais (Auth e Firestore).
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Não coloque chaves Gemini ou credenciais de servidor em variáveis VITE_*.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# No deploy, disponibilize este ID também para as Functions (não é segredo).
FIREBASE_PROJECT_ID=
